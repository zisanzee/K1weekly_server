MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/k1weekly?retryWrites=true&w=majority
PORT=4000
ALLOWED_ORIGIN=http://localhost:5173

# Single global admin credential. NO admin code is hardcoded in the source —
# set these in the deploy/host environment. On boot the app upserts a Teacher
# with this code and role 'admin', and downgrades any other admin to teacher.
# If ADMIN_CODE is left unset, the admin bootstrap is skipped (an existing admin
# row in the database keeps working).
ADMIN_CODE=
ADMIN_NAME=Admin
