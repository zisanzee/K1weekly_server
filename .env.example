MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/k1weekly?retryWrites=true&w=majority
PORT=4000

# Comma-separated list of browser origins allowed to call this API (CORS).
# MUST include every host the frontend is served from — otherwise the new
# domain's requests are rejected and the app appears "broken" with no data.
# Keep the old Netlify host during the domain transition so old links/badges
# keep working; drop it once you're fully migrated.
ALLOWED_ORIGINS=https://ezwonders.com,https://www.ezwonders.com,https://k1weekly.netlify.app,http://localhost:5173
# (A single ALLOWED_ORIGIN var is also supported for backwards compatibility.)
ALLOWED_ORIGIN=http://localhost:5173

# Single global admin credential. NO admin code is hardcoded in the source —
# set these in the deploy/host environment. On boot the app upserts a Teacher
# with this code and role 'admin', and downgrades any other admin to teacher.
# If ADMIN_CODE is left unset, the admin bootstrap is skipped (an existing admin
# row in the database keeps working).
ADMIN_CODE=
ADMIN_NAME=Admin

# --- Feedback email (Resend) -----------------------------------------------
# API key used to send the feedback form's email. Create one at
# https://resend.com/api-keys. Set it in the host's environment too (Render →
# Environment) — it must never be committed or hardcoded.
RESEND_API_KEY=

# Where feedback is delivered. Accepts a comma-separated list — every address
# gets its own copy of the email.
FEEDBACK_TO_EMAIL=you@example.com,teammate@example.com

# From address the email appears to come from. IMPORTANT: the shared
# `onboarding@resend.dev` sender only delivers to the Resend account's own
# email address. To send anywhere else, verify your domain in Resend and use an
# address on it, e.g. "EZ Wonders <feedback@ezwonders.com>".
FEEDBACK_FROM_EMAIL=EZ Wonders <onboarding@resend.dev>
